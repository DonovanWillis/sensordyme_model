# --- Python environments & caches -------------------------------------------
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# Tool caches. ruff writes .ruff_cache on every run; it was untracked-but-not-
# ignored until now, so it showed up as noise in `git status` on every machine.
.ruff_cache/
.mypy_cache/
.pyright_cache/

# --- Coverage artifacts -------------------------------------------------------
# `make test-cov` writes these. coverage.xml is what CI uploads; none of it is
# meaningful outside the run that produced it.
.coverage
.coverage.*
coverage.xml
htmlcov/

# --- Mutation testing ---------------------------------------------------------
# mutmut's session database (`make mutants`). Large, machine-local, and only
# valid for the exact source tree that produced it.
.mutmut-cache
mutants/
html/

# --- Benchmark output ---------------------------------------------------------
# Timestamped runs from benchmarks/accuracy_state_farm.py, accuracy_protocol.py
# (protocol_<ts>.json) and run_benchmarks.py are machine- and moment-specific.
# The committed BASELINE is different: it is the regression reference that
# `--compare` scores against, so it must be versioned or the gate has nothing to
# compare to.
benchmarks/results/*
!benchmarks/results/baseline_*.json

# --- Runtime output & downloaded data ---------------------------------------
# data/ holds event logs, telemetry, per-device calibration, generated reports,
# and downloaded training datasets (state_farm is ~6GB). All of it is either
# machine-specific or re-downloadable — never versioned.
data/

# Model weights fetched on first use by ultralytics / the openpilot module.
*.pt
*.hef
models/

# --- Generated iOS project ---------------------------------------------------
# SensorDyme.xcodeproj and Info.plist are generated from ios/project.yml by
# xcodegen (`cd ios && xcodegen generate`). project.yml is the source of truth
# and pins the signing team, so the generated project is disposable.
ios/SensorDyme.xcodeproj/
ios/Info.plist

# --- OS / editor -------------------------------------------------------------
.DS_Store
*.swp
.idea/
.vscode/

# Local agent/tooling scratch state (session databases, routing caches). Purely
# machine-local; nothing here reproduces on another checkout.
.claude-flow/

# --- Local operational artifacts --------------------------------------------
setup.log
setup*.log
*.local.yaml

# --- Secrets ------------------------------------------------------------------
# Real JWT signing key etc. app.py falls back to a committed dev default, which
# is fine on loopback and not fine on a LAN-exposed port.
.secrets/

# Backend database: real accounts (email + pw_hash + salt), device_key, claim
# codes, orders, event history. Was committed through e57b1bb and purged from
# history on 2026-08-06 — never track it again.
cloud/*.db

# JWT signing key, generated and persisted by cloud/app.py on first run.
cloud/.jwt_secret

# launchd's log for the always-running backend (scripts/install_backend_mac.sh).
cloud/backend.log

# Event/telemetry data written by a dev run into the repo root. These are
# DEVICE data, not source: `make deploy` excludes them (Phase 6 found the rsync
# was shipping them to customer hardware), and they must not be committed either
# -- a repo carrying a developer's event history is the same privacy problem in
# a different place. The paths are the defaults from config.yaml's logging block
# plus the short-form ones the benchmarks write.
e.csv
t.csv
events.csv
telemetry.csv
cloud/*.db
*.sqlite3
